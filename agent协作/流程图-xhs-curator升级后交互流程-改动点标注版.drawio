<mxfile host="app.diagrams.net" modified="2026-10-23T03:00:00.000Z" agent="workbuddy" version="24.0.0">
  <diagram id="xhs-curator-flow" name="xhs-curator升级后流程（改动点标注版）">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1160" math="0" shadow="0">
      <root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="start" value="用户发：链接 / 短链 / 分享文字 / 主页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E3E8EF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="62" width="300" height="42" as="geometry"/></mxCell>
<mxCell id="classify" value="🟩 &lt;b&gt;classify 硬判定&lt;/b&gt;（不再靠 AI 猜）&lt;br&gt;&lt;font style='font-size:11px' color='#8A94A6'&gt;single / profile / invalid / unknown（新增诚实态）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F3;strokeColor=#0E9F8A;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="128" width="360" height="52" as="geometry"/></mxCell>
<mxCell id="invalid" value="🟩 invalid / unknown&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;如实告知，不误报「链接无效」&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#C0392B;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="128" width="120" height="54" as="geometry"/></mxCell>
<mxCell id="engineA" value="引擎 A · 匿名单篇（全程不问）&lt;br&gt;&lt;font style='font-size:11px' color='#B45309'&gt;🟨 .md = 基础稿（非正式笔记）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E3E8EF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="210" width="240" height="48" as="geometry"/></mxCell>
<mxCell id="importMd" value="🟩 说「导入 Obsidian」才入库&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;不重抓 · 不要求登录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F3;strokeColor=#0E9F8A;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="278" width="240" height="44" as="geometry"/></mxCell>
<mxCell id="root" value="🟩 前置：仓库根定位（新节点）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;env → marker → 向上探测 → 失败输出安装引导&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;解释器一致性：用 marker 记录的 Python 跑&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F3;strokeColor=#0E9F8A;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="290" height="60" as="geometry"/></mxCell>
<mxCell id="installGuide" value="🟩 未安装 → 安装引导三步（不说链接无效）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F3;strokeColor=#0E9F8A;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="288" width="290" height="36" as="geometry"/></mxCell>
<mxCell id="delNode" value="🟥 已删除：AI 弹窗问「要保留博主评论吗」&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;改由工作台底栏复选框承接（默认不勾）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#C0392B;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="344" width="290" height="46" as="geometry"/></mxCell>
<mxCell id="workbench" value="引擎 B 工作台 · 用户勾选（主权不变）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;评论开关在底栏 · 点卡片=勾选 · 即时落盘&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E3E8EF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="410" width="290" height="46" as="geometry"/></mxCell>
<mxCell id="running" value="🟩 抓取中：结构化进度（新）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;进度条 N/M · 成功/失败/跳过 · 当前篇标题&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;⏹ 协作式停止：抓完当前篇停 → 终态 stopped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F3;strokeColor=#0E9F8A;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="476" width="290" height="66" as="geometry"/></mxCell>
<mxCell id="stopped" value="🟩 已停止（用户请求）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;已完成保留 · 继续抓取剩余自动续&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B45309;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="548" width="240" height="44" as="geometry"/></mxCell>
<mxCell id="resultCard" value="🟨 任务完成 → 持久结果卡（变更）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;四态：素材完成 / 已停止 / 部分完成 / 全部失败&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;页面级隔离：新窗口不串卡 · 知道了可关&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B45309;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="556" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="splitMd" value="🟨 素材抓取完成 ≠ Markdown 已生成（原流程要拆开）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;素材包存 downloads/；「继续整理」只复制「生成 Markdown」请求&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;部分完成：失败明细+仅重试失败项；全败：不给一键重试&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B45309;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="648" width="430" height="66" as="geometry"/></mxCell>
<mxCell id="genMd" value="🔮 生成 Markdown（P1-A 待做）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;图片价值闸门 + OCR 分级；对话发「生成 Markdown」触发&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D9B44A;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="734" width="290" height="48" as="geometry"/></mxCell>
<mxCell id="ingest" value="说「导入 Obsidian」→ 入库（不重抓）&lt;br&gt;&lt;font style='font-size:10px' color='#8A94A6'&gt;库根 attachments/ · 索引 · 评论置末 · emoji 清理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E3E8EF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="802" width="290" height="46" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;🟦 不变的铁律&lt;/b&gt;&lt;br&gt;&lt;br&gt;· 勾选主权：AI 不代勾选、不跳过勾选直接跑批量&lt;br&gt;&lt;br&gt;· 对话层绝不弹窗问评论&lt;br&gt;&lt;br&gt;· 引擎 A 单篇一律匿名&lt;br&gt;&lt;br&gt;· 关键词搜索入口不变&lt;br&gt;&lt;br&gt;· 断点续抓：已完成自动跳过&lt;br&gt;&lt;br&gt;· 单篇产物直接落盘，不引入工作台依赖&lt;br&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;🟥 原三问中的「要评论吗」已随弹窗节点删除&lt;/font&gt;&lt;br&gt;&lt;font color='#8A94A6'&gt;「抓多少」= 工作台勾选取代&lt;br&gt;「存哪里」= 弱提示保留&lt;br&gt;「弹窗问评论」= 复选框取代&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#E3E8EF;align=left;verticalAlign=top;fontSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="220" height="340" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;orthogonalEdgeStyle" edge="1" parent="1" source="start" target="classify"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;orthogonalEdgeStyle" edge="1" parent="1" source="classify" target="invalid"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="single" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="classify" target="engineA"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="classify" target="root"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="engineA" target="importMd"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="root" target="installGuide"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;dashed=1;strokeColor=#C0392B;" edge="1" parent="1" source="installGuide" target="delNode"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="delNode" target="workbench"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="workbench" target="running"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="用户停止" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="running" target="stopped"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="全部处理完" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="running" target="resultCard"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="resultCard" target="splitMd"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;dashed=1;strokeColor=#D9B44A;" edge="1" parent="1" source="splitMd" target="genMd"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="genMd" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="继续抓取剩余（自动续）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontSize=11;fontColor=#2F6FD0;labelBackgroundColor=none;" edge="1" parent="1" source="stopped" target="running"><mxGeometry relative="1" as="geometry"/></mxCell>
